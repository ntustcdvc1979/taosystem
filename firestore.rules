rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== 授權白名單 =====
    // 只有下面清單裡的 Google 帳號 Email 才能存取資料。
    // 要新增使用者：把對方的 Google Email 加到這個陣列裡，然後重新發布規則。
    function isAllowed() {
      return request.auth != null &&
             request.auth.token.email in [
               'damoncho510@gmail.com'
               // , 'someone@gmail.com'
               // , 'another@gmail.com'
             ];
    }

    // 團隊名單：白名單成員共同管理，彼此都看得到
    match /entries/{entryId} {
      allow read, write: if isAllowed();
    }

    // 個人名單：只有建立者本人看得到、改得動，其他白名單成員一律讀不到。
    // ownerUid 必須等於自己的 uid，避免有人把資料掛到別人名下或偷看別人的。
    match /personalEntries/{entryId} {
      allow read, delete: if isAllowed() && resource.data.ownerUid == request.auth.uid;
      allow create: if isAllowed() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAllowed()
                    && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == request.auth.uid;
    }

    // 共用設定：config/ai 放 AI 的共用 API Key、config/team 放團隊名單的稱呼。
    // 白名單成員都能讀；只有團隊名稱可以在網頁上改，API Key 一律只能從 Console 設定。
    match /config/{docId} {
      allow read: if isAllowed();
      allow write: if isAllowed() && docId == 'team';
    }

    // 近期活動（活動管理頁維護：名稱、日期、類型），白名單成員可讀寫
    match /events/{eventId} {
      allow read, write: if isAllowed();
    }

    // AI 成全助手的對話紀錄，每位使用者一份（文件 ID = 使用者 uid）。
    // 除了要在白名單內，還限定只能讀寫自己那一份，看不到別人的對話。
    match /chatHistories/{userId} {
      allow read, write: if isAllowed() && request.auth.uid == userId;
    }

    // 其他所有路徑一律拒絕
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
