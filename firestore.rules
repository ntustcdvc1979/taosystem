rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== 帳號歸屬 =====
    // 每支帳號屬於哪個道務單位，由管理員在 Firebase Console 設定，網頁端一律不能寫入。
    //   memberEmails/{gmail}  欄位 unitId
    function isSignedIn() {
      return request.auth != null;
    }
    function hasMember() {
      return isSignedIn() && request.auth.token.email != null &&
             exists(/databases/$(database)/documents/memberEmails/$(request.auth.token.email));
    }
    function myUnit() {
      return get(/databases/$(database)/documents/memberEmails/$(request.auth.token.email)).data.unitId;
    }
    function inUnit(unitId) {
      return hasMember() && myUnit() == unitId;
    }
    // 身分階梯：點傳師 4 ＞ 忠義字班講師 3 ＞ 成全組長 2 ＞ 組員 1 ＞ 非組員 0。
    // 帳號的身分寫在 memberEmails/{gmail}.roleRank（沒寫就當組員），由講師或道務組組長設定；
    // 名單每一筆也有 roleRank，一個人只看得到「比自己目前檢視身分更低階」的名單，
    // 所以同階之間互相看不到。
    function myRank() {
      return get(/databases/$(database)/documents/memberEmails/$(request.auth.token.email))
               .data.get('roleRank', 1);
    }
    // 忠義字班講師以上（含點傳師）：可以設定名單每一筆的身分
    function isTeacher() {
      return hasMember() && myRank() >= 3;
    }
    // 成全組長以上：可以管理使用者（增減帳號、設定身分）
    function canManageMembers() {
      return hasMember() && myRank() >= 2;
    }
    // 能把別人設到哪一階：組長只能設到自己這階以下，講師以上可以指派到點傳師（4）
    function maxAssignableRank() {
      return myRank() >= 3 ? 4 : myRank();
    }

    // 帳號歸屬：本人讀得到自己那一份；組長／講師讀得到（也管得到）同單位的每一份
    match /memberEmails/{email} {
      allow read: if isSignedIn() &&
                     (request.auth.token.email == email ||
                      (canManageMembers() && resource.data.unitId == myUnit()));
      // 組長只能設到自己這一階以下；忠義字班講師以上可以一路指派到點傳師（4）
      allow create: if canManageMembers() && request.resource.data.unitId == myUnit()
                    && request.resource.data.get('roleRank', 1) <= maxAssignableRank();
      // 也不能改自己的身分（免得自我升等）
      allow update: if canManageMembers() && resource.data.unitId == myUnit()
                    && request.resource.data.unitId == myUnit()
                    && request.resource.data.get('roleRank', 1) <= maxAssignableRank()
                    && (request.auth.token.email != email
                        || request.resource.data.get('roleRank', 1) == resource.data.get('roleRank', 1));
      // 不能把自己刪掉，免得整個單位沒人管得動
      allow delete: if canManageMembers() && resource.data.unitId == myUnit()
                    && request.auth.token.email != email;
    }

    // ===== 道務單位 =====
    // 單位名稱等資料由 Console 設定，網頁只顯示不修改
    match /units/{unitId} {
      allow read: if inUnit(unitId);
      allow write: if false;

      // 團隊名單：同單位共管，但只看得到比自己低階的人（roleRank 沒寫就當 0＝非組員）
      match /entries/{entryId} {
        allow read: if inUnit(unitId) && resource.data.get('roleRank', 0) < myRank();
        // 一般成員只能建立／維護非組員；要把某一筆標成組員以上，得是講師
        allow create: if inUnit(unitId)
                      && (request.resource.data.get('roleRank', 0) == 0 || isTeacher());
        allow update: if inUnit(unitId)
                      && resource.data.get('roleRank', 0) < myRank()
                      && (request.resource.data.get('roleRank', 0)
                            == resource.data.get('roleRank', 0)
                          || isTeacher());
        allow delete: if inUnit(unitId) && resource.data.get('roleRank', 0) < myRank();
      }

      // 個人名單：同單位、且只有建立者本人存取得到
      match /personalEntries/{entryId} {
        allow read, delete: if inUnit(unitId) && resource.data.ownerUid == request.auth.uid;
        allow create: if inUnit(unitId) && request.resource.data.ownerUid == request.auth.uid;
        allow update: if inUnit(unitId)
                      && resource.data.ownerUid == request.auth.uid
                      && request.resource.data.ownerUid == request.auth.uid;
      }

      // 活動
      match /events/{eventId} {
        allow read, write: if inUnit(unitId);
      }

      // AI 成全助手的對話紀錄：只有本人讀寫得到
      match /chatHistories/{userId} {
        allow read, write: if inUnit(unitId) && request.auth.uid == userId;
      }

      // 帳號綁定到名單中的哪一位：同單位可讀（才知道誰是誰），但只能設定自己的
      match /memberLinks/{userId} {
        allow read: if inUnit(unitId);
        allow write: if inUnit(unitId) && request.auth.uid == userId;
      }

      // 綁定用的姓名索引：只有姓名、系級、身分，同單位都讀得到，
      // 身分階梯不擋這裡——不然看不到高階名單的人就永遠綁不到自己那一筆。
      match /rosterIndex/{entryId} {
        allow read, write: if inUnit(unitId);
      }
    }

    // ===== 共用設定 =====
    // config/ai 放 AI 的共用 API Key，跨單位共用；只能從 Console 設定
    match /config/{docId} {
      allow read: if hasMember();
      allow write: if false;
    }

    // 其他所有路徑一律拒絕（含舊版放在最上層的 entries / personalEntries / events）
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
