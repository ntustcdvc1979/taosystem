rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== 帳號歸屬 =====
    // 每支帳號屬於哪個道務單位，由管理員在 Firebase Console 設定，網頁端一律不能寫入。
    // 兩種指派方式，擇一即可（都沒有＝未授權，登入後什麼都讀不到）：
    //   memberEmails/{gmail}  欄位 unitId ← 不必先問到 UID，建議用這個
    //   members/{uid}         欄位 unitId ← 精準綁定某支帳號，優先於 Email
    function isSignedIn() {
      return request.auth != null;
    }
    function byUid() {
      return exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }
    function byEmail() {
      return request.auth.token.email != null &&
             exists(/databases/$(database)/documents/memberEmails/$(request.auth.token.email));
    }
    function hasMember() {
      return isSignedIn() && (byUid() || byEmail());
    }
    function myUnit() {
      return byUid()
        ? get(/databases/$(database)/documents/members/$(request.auth.uid)).data.unitId
        : get(/databases/$(database)/documents/memberEmails/$(request.auth.token.email)).data.unitId;
    }
    function inUnit(unitId) {
      return hasMember() && myUnit() == unitId;
    }

    // 帳號歸屬：只讀得到自己那一份，且只能從 Console 設定
    match /members/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /memberEmails/{email} {
      allow read: if isSignedIn() && request.auth.token.email == email;
      allow write: if false;
    }

    // ===== 道務單位 =====
    // 單位名稱等資料由 Console 設定，網頁只顯示不修改
    match /units/{unitId} {
      allow read: if inUnit(unitId);
      allow write: if false;

      // 團隊名單：同單位成員共管
      match /entries/{entryId} {
        allow read, write: if inUnit(unitId);
      }

      // 個人名單：同單位、且只有建立者本人存取得到
      match /personalEntries/{entryId} {
        allow read, delete: if inUnit(unitId) && resource.data.ownerUid == request.auth.uid;
        allow create: if inUnit(unitId) && request.resource.data.ownerUid == request.auth.uid;
        allow update: if inUnit(unitId)
                      && resource.data.ownerUid == request.auth.uid
                      && request.resource.data.ownerUid == request.auth.uid;
      }

      // 活動
      match /events/{eventId} {
        allow read, write: if inUnit(unitId);
      }

      // AI 成全助手的對話紀錄：只有本人讀寫得到
      match /chatHistories/{userId} {
        allow read, write: if inUnit(unitId) && request.auth.uid == userId;
      }

      // 帳號綁定到名單中的哪一位：同單位可讀（才知道誰是誰），但只能設定自己的
      match /memberLinks/{userId} {
        allow read: if inUnit(unitId);
        allow write: if inUnit(unitId) && request.auth.uid == userId;
      }
    }

    // ===== 共用設定 =====
    // config/ai 放 AI 的共用 API Key，跨單位共用；只能從 Console 設定
    match /config/{docId} {
      allow read: if hasMember();
      allow write: if false;
    }

    // 其他所有路徑一律拒絕（含舊版放在最上層的 entries / personalEntries / events）
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
