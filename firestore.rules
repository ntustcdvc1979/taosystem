rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== 帳號歸屬 =====
    // 每支帳號屬於哪個道務單位，由管理員在 Firebase Console 設定，網頁端一律不能寫入。
    //   memberEmails/{gmail}  欄位 unitId
    function isSignedIn() {
      return request.auth != null;
    }
    function hasMember() {
      return isSignedIn() && request.auth.token.email != null &&
             exists(/databases/$(database)/documents/memberEmails/$(request.auth.token.email));
    }
    function myUnit() {
      return get(/databases/$(database)/documents/memberEmails/$(request.auth.token.email)).data.unitId;
    }
    function inUnit(unitId) {
      return hasMember() && myUnit() == unitId;
    }
    // 道務組組長：寫在 units/{unitId}.leaderEmails（陣列），只能從 Console 指定。
    // 組長可以增減「自己單位」的使用者 Email，但不能指派組長、也碰不到別的單位。
    function isLeader() {
      return hasMember() &&
             get(/databases/$(database)/documents/units/$(myUnit()))
               .data.get('leaderEmails', []).hasAny([request.auth.token.email]);
    }

    // 帳號歸屬：本人讀得到自己那一份；組長讀得到（也管得到）同單位的每一份
    match /memberEmails/{email} {
      allow read: if isSignedIn() &&
                     (request.auth.token.email == email ||
                      (isLeader() && resource.data.unitId == myUnit()));
      allow create: if isLeader() && request.resource.data.unitId == myUnit();
      allow update: if isLeader() && resource.data.unitId == myUnit()
                    && request.resource.data.unitId == myUnit();
      // 組長不能把自己刪掉，免得整個單位沒人管得動
      allow delete: if isLeader() && resource.data.unitId == myUnit()
                    && request.auth.token.email != email;
    }

    // ===== 道務單位 =====
    // 單位名稱等資料由 Console 設定，網頁只顯示不修改
    match /units/{unitId} {
      allow read: if inUnit(unitId);
      allow write: if false;

      // 團隊名單：同單位成員共管
      match /entries/{entryId} {
        allow read, write: if inUnit(unitId);
      }

      // 個人名單：同單位、且只有建立者本人存取得到
      match /personalEntries/{entryId} {
        allow read, delete: if inUnit(unitId) && resource.data.ownerUid == request.auth.uid;
        allow create: if inUnit(unitId) && request.resource.data.ownerUid == request.auth.uid;
        allow update: if inUnit(unitId)
                      && resource.data.ownerUid == request.auth.uid
                      && request.resource.data.ownerUid == request.auth.uid;
      }

      // 活動
      match /events/{eventId} {
        allow read, write: if inUnit(unitId);
      }

      // AI 成全助手的對話紀錄：只有本人讀寫得到
      match /chatHistories/{userId} {
        allow read, write: if inUnit(unitId) && request.auth.uid == userId;
      }

      // 帳號綁定到名單中的哪一位：同單位可讀（才知道誰是誰），但只能設定自己的
      match /memberLinks/{userId} {
        allow read: if inUnit(unitId);
        allow write: if inUnit(unitId) && request.auth.uid == userId;
      }
    }

    // ===== 共用設定 =====
    // config/ai 放 AI 的共用 API Key，跨單位共用；只能從 Console 設定
    match /config/{docId} {
      allow read: if hasMember();
      allow write: if false;
    }

    // 其他所有路徑一律拒絕（含舊版放在最上層的 entries / personalEntries / events）
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
